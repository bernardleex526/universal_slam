<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>adapter_sw01</name>
  <version>0.1.0</version>
  <description>
    SW01（璇玑动力 Hypertron）适配器：封装 Daedalus 专有 C 库 (libASTRALL_SDK.so)。
    IMU 250Hz → /imu_raw；UDP 6100 点云重组 → /points_raw；/cmd_vel → AstrallMove。
  </description>
  <maintainer email="dev@universal-slam.local">Universal SLAM Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
