<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_configs</name>
  <version>0.1.0</version>
  <description>
    每机型一份 yaml：外参初值 / 最大速度 / 雷达类型 / TF 帧名 / 网络参数。
    接入新机型 = 此包加一份 config + robot_adapters 加一个 adapter 包。
  </description>
  <maintainer email="dev@universal-slam.local">Universal SLAM Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
