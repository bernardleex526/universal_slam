<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>universal_slam_bringup</name>
  <version>0.1.0</version>
  <description>
    通用 SLAM 系统统一入口：ros2 launch universal_slam_bringup universal_slam.launch.py robot:=m20|sw01
    一键启动静态 TF + FAST-LIO2 + Nav2 导航栈（+ P2 机型适配器）。
  </description>
  <maintainer email="dev@universal-slam.local">Universal SLAM Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>slam_nav_core</exec_depend>
  <exec_depend>robot_configs</exec_depend>
  <exec_depend>robot_adapters</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
