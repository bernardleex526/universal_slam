+// A bounded, voxelized full-session map, independent of visualization timers.
+std::map<std::tuple<int64_t,int64_t,int64_t>,PointType> saved_voxels;
+double save_voxel_size = 0.1;
+int save_max_points = 2000000;
+bool save_map_overflow = false;
+void accumulate_save_map()
+{
+    if (!pcd_save_en || save_map_overflow) return;
+    for (const auto & point : feats_down_body->points) {
+        PointType world;
+        RGBpointBodyToWorld(&point, &world);
+        const auto key = std::make_tuple(
+            static_cast<int64_t>(std::floor(world.x/save_voxel_size)),
+            static_cast<int64_t>(std::floor(world.y/save_voxel_size)),
+            static_cast<int64_t>(std::floor(world.z/save_voxel_size)));
+        if (saved_voxels.count(key)) continue;
+        if (saved_voxels.size() >= static_cast<size_t>(save_max_points)) {
+            save_map_overflow = true; return;
+        }
+        saved_voxels.emplace(key, world);
+    }
+}
