+    PointCloudXYZI map;
+    map.reserve(saved_voxels.size());
+    for (const auto & item : saved_voxels) map.push_back(item.second);
+    const std::filesystem::path path(map_file_path);
+    if (!path.parent_path().empty()) std::filesystem::create_directories(path.parent_path());
+    const auto temporary = map_file_path + ".tmp";
+    pcl::PCDWriter writer;
+    if (writer.writeBinary(temporary, map) < 0) return false;
+    std::filesystem::rename(temporary, path);
+    return true;
 }
 
