<?xml version="1.0" encoding="UTF-8"?>
<!-- CycloneDDS on loopback disables multicast and, by default, caps auto participant
     indices at 9; the full mapping + Nav2 stack has more participants than that.
     MaxMessageSize keeps every UDP datagram below a 1500-byte MTU. With the default
     (14720 B) several fragments share one datagram; where large datagrams are dropped
     (WSL mirrored-networking loopback, MTU-1500 links) a reliable writer recovers through
     per-fragment retransmits but a best-effort reader never does, and Nav2's obstacle
     layer subscribes best-effort, so /uslam/obstacles silently never reached the costmap.
     Use: export CYCLONEDDS_URI=file://$(ros2 pkg prefix slam_nav_core)/share/slam_nav_core/config/cyclonedds_localhost.xml -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <MaxMessageSize>1400B</MaxMessageSize>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
      <Peers>
        <Peer Address="localhost"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
